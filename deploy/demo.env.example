# The demo: demo.linerai.us/<store> -- Craig and Landreth, and the Riverside
# fixture as the unprefixed store. Isolated from production: its own checkout
# (/srv/liner-demo), its own user, its own Postgres role and databases, and
# no mail leaves it.
#
# docs/NEW-SERVER.md copies this to /srv/liner-demo/.env and fills every
# __GENERATE__ and __PGPASS__ (the demo role's, not production's).

ENV=production
SESSION_SECRET=__GENERATE__

# Served by path: demo.linerai.us/craigandlandreth/... No STORE_DOMAIN -- that
# is production's, and a demo answering for *.linerai.us would be a demo
# answering for Alsbou's address.
PUBLIC_BASE_URL=https://demo.linerai.us

DATABASE_URL=postgresql+psycopg://linerdemo:__PGPASS__@127.0.0.1:5432/liner_demo
DATABASE_URL_TEMPLATE=postgresql+psycopg://linerdemo:__PGPASS__@127.0.0.1:5432/liner_demo_{slug}
OPS_DATABASE_URL=postgresql+psycopg://linerdemo:__PGPASS__@127.0.0.1:5432/liner_demo_ops
ALLOWED_ORIGINS=

MANAGER_PASSWORD=__GENERATE__
REP_PASSWORD=__GENERATE__
OWNER_PASSWORD=__GENERATE__
FOUNDER_PASSWORD=__GENERATE__
CTO_PASSWORD=__GENERATE__

# The same model key as production. Yours.
LLM_MODE=live
OPENAI_API_KEY=
VOICE_PROVIDER=openai

# Nothing leaves: every email is a row in the outbox and nowhere else.
EMAIL_SENDER=outbox
OUTBOUND_ONLY_TO=

# Nothing posts mail here, and no phone line points here. Random values seal
# both webhooks, which the boot requires.
WEBHOOK_SECRET=__GENERATE__
TWILIO_AUTH_TOKEN=__GENERATE__

# Anyone with the link walks into the dashboard as a rep: the point of a
# demo. It shows seeded buyers only -- never turn this on in production.
PUBLIC_DEMO=true
