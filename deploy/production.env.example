# Production: linerai.us (the landing page, /ops, Liner's own mail) and
# alsbou.linerai.us (Alsbou's dashboard, storefront and website chat).
#
# docs/NEW-SERVER.md copies this to /srv/liner/.env and fills every
# __GENERATE__ (a different random value each) and __PGPASS__ (the database
# role's password, the same in all three URLs). The empty lines marked
# "yours" are filled by a person, in a terminal -- never pasted into a chat.
# `make live-check` reads this file and says which are still missing.

ENV=production
SESSION_SECRET=__GENERATE__

# The subdomain is the store: alsbou.linerai.us is Alsbou's.
STORE_DOMAIN=linerai.us
# Liner's own address: the phone line's webhooks, and links from /ops.
PUBLIC_BASE_URL=https://linerai.us

# One database per store; {slug} is the store's profile name. The bare
# DATABASE_URL is the unprefixed store, which nothing is served from here --
# it holds the events /ops replays and mail addressed to nobody.
DATABASE_URL=postgresql+psycopg://liner:__PGPASS__@127.0.0.1:5432/liner
DATABASE_URL_TEMPLATE=postgresql+psycopg://liner:__PGPASS__@127.0.0.1:5432/liner_{slug}
OPS_DATABASE_URL=postgresql+psycopg://liner:__PGPASS__@127.0.0.1:5432/liner_ops

# Empty on purpose: every page calls its own host, and the stores' subdomains
# are one site to a browser (docs/DEPLOY.md, "ALLOWED_ORIGINS stays empty").
ALLOWED_ORIGINS=

# Production refuses to boot on the development default of any of these, or
# on two that are the same. Alsbou's own people get passwords of their own,
# printed once by the seed; these are the fallbacks the boot insists on.
MANAGER_PASSWORD=__GENERATE__
REP_PASSWORD=__GENERATE__
OWNER_PASSWORD=__GENERATE__
FOUNDER_PASSWORD=__GENERATE__
CTO_PASSWORD=__GENERATE__

# The model. Yours: the key. Copy OPENAI_MODEL too if the old box set one.
LLM_MODE=live
OPENAI_API_KEY=
# The website call (/call). The same key.
VOICE_PROVIDER=openai

# Email out through Resend, from sales@alsbou.linerai.us for Alsbou and
# support@linerai.us for Liner. Both domains verified in Resend.
EMAIL_SENDER=resend
# Yours.
RESEND_API_KEY=
SENDING_DOMAIN=linerai.us
# Who mail may reach. Empty refuses every send. Yours: your own address while
# checking, then `everyone` when Alsbou's buyers should get their mail.
OUTBOUND_ONLY_TO=

# Email in. Yours: the value the Cloudflare Worker holds
# (`wrangler secret put WEBHOOK_SECRET`) -- the two have to be equal.
WEBHOOK_SECRET=

# Twilio, copied from the old box's .env unchanged, and not tested here: the
# line is Liner's own and answered on linerai.us. Until the real token is in,
# this random one seals the phone webhook -- nobody can sign a request with it.
TWILIO_AUTH_TOKEN=__GENERATE__
# TWILIO_ACCOUNT_SID=
# TWILIO_NUMBER=
# TWILIO_API_KEY_SID=
# TWILIO_API_KEY_SECRET=
# TWILIO_OPS_NUMBER=

# The headless Chromium an inventory refresh uses for a site that refuses
# anything but a browser (GMA: alsboucars.com). Installed there by
# docs/NEW-SERVER.md step 1, outside any home directory: the unit's
# ProtectHome hides those from the service.
PLAYWRIGHT_BROWSERS_PATH=/opt/pw-browsers
