{
	"name": "crm-inbound-worker",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-11",
	"observability": {
		"enabled": true
	},
	"vars": {
		// The path is aliased in the backend, so /api/inbound-email reaches the
		// same handler. Whichever you use, it must be the public origin -- the
		// Worker runs on Cloudflare's edge and cannot see a private address.
		// This is the JSON intake the previous Worker posted to; it is kept
		// because this Worker derives the raw URL from it when the next line
		// is missing, and because a deploy overwrites vars it does not name.
		"WEBHOOK_URL": "https://linerai.us/api/emails/inbound",
		// Where this Worker posts: the message itself, as message/rfc822,
		// with the SMTP envelope in X-Envelope-From / X-Envelope-To. Same
		// host, same secret. /api/inbound-email/raw is the same handler.
		"WEBHOOK_RAW_URL": "https://linerai.us/api/emails/inbound/raw",
		// Every local part the intake accepts, on every domain Cloudflare
		// routes here -- `linerai.us` and each dealership's own subdomain
		// (`alsbou.linerai.us`). The first five are Liner's own and the reply
		// tokens; `sales@` is also Alsbou's production mailbox,
		// `sales@alsbou.linerai.us`, which the intake files in Alsbou's store
		// by its domain. After them, one mailbox per dealership on the shared
		// domain -- the `mailbox:` in each profile under
		// backend/config/dealerships/. `alsbou@` is what Alsbou's mail was
		// before it had a domain of its own; kept so nothing already sent to it
		// is thrown away, and filed in the default store, which on the
		// production box is Alsbou's. A new dealership is a new entry here
		// *and* a `wrangler deploy`; `make smoke` fails if a profile's mailbox
		// is missing from this list.
		"ALLOWED_RECIPIENTS": "support@,sales@,founder@,cto@,reply+,alsbou@,craigandlandreth@"
		// One box serves linerai.us and every dealership subdomain, so every
		// message goes to the URLs above and there is no `ROUTES`. It exists
		// for the day a dealership's mail has to go to a different server
		// than Liner's own: `prefix=url` pairs, first match wins, everything
		// else to the URL above, both boxes on the same WEBHOOK_SECRET
		// (docs/DEPLOY.md, "Mail: one Worker, two boxes"). Kept in this file,
		// not the dashboard: a deploy overwrites vars it does not name.
		// Uncommented, the line above needs a comma after it.
		// "ROUTES": "alsbou@=https://alsbou.linerai.us/api/emails/inbound/raw,reply+=https://alsbou.linerai.us/api/emails/inbound/raw"
	}

	// WEBHOOK_SECRET is deliberately NOT here. `vars` are plaintext in the
	// dashboard and in git, and this one is the only thing in front of an
	// endpoint that writes into a buyer's history:
	//
	//     wrangler secret put WEBHOOK_SECRET
	//
	// It has to equal the backend's WEBHOOK_SECRET exactly. The comparison is
	// constant time, so a mismatch fails identically to any other wrong value
	// -- /app/email is where you find out, not the logs.
}
